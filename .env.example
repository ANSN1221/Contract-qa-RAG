# 复制本文件为 .env 后填入真实密钥。.env 已被 .gitignore 排除，不会进入版本库。
# ---------------------------------------------------------------------------
# 对话模型：DeepSeek（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 向量化模型：DeepSeek 不提供 Embedding 接口，改用硅基流动的 bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 检索与存储
# 重排（rerank）：交叉编码器对候选条款重新打分。默认关闭，D5 评测确认收益后再打开。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 与向量化同为硅基流动时可留空，自动复用 EMBEDDING_API_KEY / EMBEDDING_BASE_URL
RERANK_API_KEY=
RERANK_BASE_URL=
# 送入重排的候选数，越大越准也越慢
RERANK_CANDIDATES=16
# 引用校验：是否调用模型核对答案与引用条款的一致性（关闭后只跑规则校验，省一次调用）
VERIFY_LLM=true
CHROMA_PATH=./chroma

# 条款文件与索引目录（parse 输出与 index 读取共用，默认 data/processed）
PROCESSED_DIR=data/processed

# 双路召回权重（加权 RRF 融合；默认 1:1——D5 三轮评测结论，权重比超过约 1.31 会压制单路命中）
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.0
